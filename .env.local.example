NEXTAUTH_SECRET=secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SMTP mail settings for Nodemailer
# Replace with your provider settings (SendGrid, Mailgun, Postmark, etc.)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=<USERNAME>
MAIL_PASS=<PASSWORD>
MAIL_FROM="<EMAIL>"
# Secret used to sign reset tokens (make this a long random string)
RESET_TOKEN_SECRET=secret_email_reset_token
NODE_ENV=development

# MongoDB Configuration
MONGODB_USER=<MONGODB_USER>
MONGODB_PASSWORD=<MONGODB_PASSWORD>
MONGODB_URL=<MONGODB_URL>
MONGODB_DB_NAME=<MONGODB_DB_NAME>

# Product analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=<POSTHOG_PROJECT_API_KEY>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Trial Period 
NEXT_PUBLIC_TRIAL_NUMBER_OF_DAYS=30
CRON_SECRET_TOKEN=super-secret-cron-token-change-this-in-production

# Subscription Plan Pricing (in PKR) - Single Plan
NEXT_PUBLIC_PRO_PLAN_PRICE=1000 
NEXT_PUBLIC_PRO_PLAN_NAME=PRO
GRACE_PERIOD_DAYS=7
GRACE_PERIOD_EMAIL_SUBJECT="Dukaan Khata - Payment Reminder"
GRACE_PERIOD_EMAIL_MSG="Dear user, your subscription expired on {{EXPIRY_DATE}}. Please renew to avoid account suspension."

